# Copy to .streamlit/secrets.toml for local Streamlit runs.
# On Streamlit Cloud: App settings → Secrets (same TOML format).

DATABASE_URL = "postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Optional — only needed if you extend the Streamlit app for Storage/email
# SUPABASE_URL = "https://[PROJECT_REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY = "eyJ..."
# JWT_SECRET = "generate-with-openssl-rand-hex-32"
